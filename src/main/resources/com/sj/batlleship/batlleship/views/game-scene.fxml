<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="628.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sj.batlleship.batlleship.controllers.Game">-->

<BorderPane prefHeight="595.0" prefWidth="963.0" style="-fx-background-color: linear-gradient(to bottom, #1a237e, #0d47a1);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sj.batlleship.batlleship.controllers.Game">
    
    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>
            <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 2);" text="BATTLESHIP" />
            <Label text="Defeat your opponent" textFill="#00ff37" />
        </VBox>
    </top>
    
    <bottom>
        <HBox alignment="CENTER" prefHeight="48.0" prefWidth="929.0" spacing="16.0" style="-fx-background-color: rgba(0,0,0,0.3);">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>
            <children>
                <Label style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;" text="Status:" />
                <Label fx:id="gameStatusText" style="-fx-font-size: 16px; -fx-text-fill: #11ff00;" text="Prep phase" />
                <Region prefWidth="20" />
                <Button fx:id="gameControlButton" mnemonicParsing="false" onAction="#handleGameControl" style="-fx-font-size: 14px; -fx-min-width: 150px; -fx-background-radius: 5;" text="Start New Game" />
                <Button fx:id="quitGameButton" mnemonicParsing="false" onAction="#quitGame" style="-fx-font-size: 14px; -fx-min-width: 100px; -fx-background-radius: 5;" text="Quit" />
            </children>
        </HBox>
    </bottom>
    
    <center>
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="10">
                    <GridPane id="playerBoard" fx:id="playerBoard" alignment="CENTER" gridLinesVisible="true" prefHeight="362.0" prefWidth="393.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-color: white; -fx-border-width: 2;">
                     <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <VBox.margin>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </VBox.margin>
                    </GridPane>
                    <Label style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;" text="My Board" />
                </VBox>
                
                <VBox alignment="CENTER" spacing="10">
                    <GridPane id="enemyBoard" fx:id="enemyBoard" alignment="CENTER" gridLinesVisible="true" prefHeight="362.0" prefWidth="389.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-color: white; -fx-border-width: 2;">
                     <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <VBox.margin>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </VBox.margin>
                    </GridPane>
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #ff4444; -fx-font-weight: bold;" text="Enemy Board" />
                </VBox>
            </children>
        </HBox>
    </center>
    
    <left>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 20;">
            <children>
                <Label fx:id="shipNameLabel" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;" />
                <ImageView fx:id="showCurrentShip" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <VBox.margin>
                  <Insets bottom="2.0" />
               </VBox.margin></ImageView>
                <Button fx:id="rotateShipButton" mnemonicParsing="false" onAction="#rotateShip" style="-fx-font-size: 14px; -fx-min-width: 150px; -fx-background-radius: 5;" text="Rotate Ship">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets top="5.0" />
               </padding></Button>
            </children>
        </VBox>
    </left>
</BorderPane>
