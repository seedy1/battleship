<StackPane prefHeight="475.0" prefWidth="482.0" style="-fx-background-color: linear-gradient(to bottom, #1a237e, #0d47a1);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sj.batlleship.batlleship.controllers.Welcome">
    <VBox alignment="CENTER" maxWidth="800" spacing="30.0">
        <padding>
            <javafx.geometry.Insets bottom="50" left="50" right="50" top="50" />
        </padding>
        
        <Label style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 2);" styleClass="h1, b, lbl-success" text="BATTLESHIP" />
        
        <Region prefHeight="20" />
        
        <VBox alignment="CENTER" spacing="15" styleClass="game-options">
            <Button mnemonicParsing="false" onAction="#startSoloGameWithRandomAI" style="-fx-font-size: 18px; -fx-min-width: 300px; -fx-background-radius: 10;" styleClass="btn, btn-primary" text="SOLO: Start Game" />
            
            <Button fx:id="testClick" mnemonicParsing="false" onAction="#startSoloGameWithSmartAI" style="-fx-font-size: 18px; -fx-min-width: 300px; -fx-background-radius: 10;" styleClass="btn, btn-primary" text="SOLO: Start Game (Smart Opp)" />
            
            <Button disable="true" mnemonicParsing="false" style="-fx-font-size: 18px; -fx-min-width: 300px; -fx-background-radius: 10; -fx-opacity: 0.7;" styleClass="btn, btn-primary" text="Multiplayer (COMING SOON)" />
        </VBox>
        
        <Region prefHeight="20" />
        
        <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Choose your game mode to begin" />
    </VBox>
</StackPane>
