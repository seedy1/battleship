<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="628.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sj.batlleship.batlleship.controllers.Game">-->

<BorderPane prefHeight="595.0" prefWidth="963.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sj.batlleship.batlleship.controllers.Game">
    <top>
        <!--      <Label prefHeight="17.0" prefWidth="203.0" text="Label" BorderPane.alignment="CENTER" />-->
        <Label prefHeight="31.0" prefWidth="143.0" text="Label" BorderPane.alignment="CENTER" />
    </top>
    <bottom>
        <!--      <HBox alignment="CENTER" prefHeight="104.0" prefWidth="603.0" spacing="16.0" BorderPane.alignment="CENTER">-->
        <HBox alignment="CENTER" prefHeight="48.0" prefWidth="929.0" spacing="16.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Status:" textFill="#11ff00" />
                <Label fx:id="gameStatusText" text="Prep phase" textFill="#11ff00" />
                <Button fx:id="gameControlButton" mnemonicParsing="false" onAction="#handleGameControl" text="Start New Game" />
                <Button fx:id="quitGameButton" mnemonicParsing="false" onAction="#quitGame" text="Quit" />
            </children>
        </HBox>
    </bottom>
    <center>
        <!--      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">-->
        <HBox BorderPane.alignment="CENTER">
            <children>
                <VBox prefHeight="516.0" prefWidth="420.0">
                    <children>
                        <GridPane id="playerBoard" fx:id="playerBoard" alignment="CENTER" gridLinesVisible="true" prefHeight="362.0" prefWidth="393.0">
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin></GridPane>
                        <Label text="My Board" />
                    </children>
                </VBox>
                <VBox prefHeight="516.0" prefWidth="416.0">
                    <children>
                        <GridPane id="enemyBoard" fx:id="enemyBoard" alignment="CENTER" gridLinesVisible="true" prefHeight="362.0" prefWidth="389.0">
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin></GridPane>
                        <Label text="Enemy Board" textFill="RED" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
    <left>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="shipNameLabel" prefHeight="17.0" prefWidth="115.0" text="Label" />
                <ImageView fx:id="showCurrentShip" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                <Button fx:id="rotateShipButton" mnemonicParsing="false" onAction="#rotateShip" text="Rotate Ship" />
            </children>
        </VBox>
    </left>
</BorderPane>
